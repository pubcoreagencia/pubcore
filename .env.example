# =============================================================================
# PUB CORE — Environment Variables
# =============================================================================
#
# Copie este arquivo para .env e preencha com os valores reais.
# NUNCA commite o .env — todos os valores abaixo são sensíveis.
#
# Classificação:
#   PUBLIC   — pode aparecer no cliente (prefixo VITE_ no Vite)
#   SERVER   — apenas no servidor (backend, build)
#   SECRET   — credencial, nunca chegar ao cliente
# =============================================================================

# -----------------------------------------------------------------------------
# PUBLIC — Expostas no cliente (prefira VITE_ para Vite)
# -----------------------------------------------------------------------------

# Supabase project identifier (semi-public — aparece no cliente)
SUPABASE_PROJECT_ID=

# Supabase project URL (semi-public — usado no cliente)
SUPABASE_URL=

# Supabase publishable/anon key — POR DESIGN exposta ao cliente.
# Nunca use SERVICE_ROLE_KEY aqui.
SUPABASE_PUBLISHABLE_KEY=

# Vite-prefixed versions of the above (injetadas pelo Vite)
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
